{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "History",
  "description": "GET /v1/history",
  "type": "object",
  "required": ["revisions"],
  "additionalProperties": false,
  "properties": {
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["revision", "document", "parents", "path", "deleted", "hash", "bytes", "origin", "created"],
        "additionalProperties": false,
        "properties": {
          "revision": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
          "document": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
          "parents": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{32}$"}},
          "path": {"type": "string"},
          "deleted": {"type": "boolean"},
          "hash": {"type": ["string", "null"]},
          "bytes": {"type": ["integer", "null"]},
          "origin": {"type": "string"},
          "created": {"type": "string"}
        }
      }
    }
  }
}
