import { currentSizeClass, onSizeClassChange } from './sizeClass.ts'

// SwiftUI's horizontalSizeClass for the web: "compact" (a phone or a narrow window) or "regular".
// Create one per view that needs it and call observe(signal) from .task.
// The field is not called "value": Mün reads "state.value" as the state's own reference.
@Observable
final class SizeClass {
  var horizontal = currentSizeClass()
  func observe(signal) {
    let stop = onSizeClassChange(next => { this.horizontal = next })
    signal.addEventListener('abort', stop, { once: true })
  }
}
export { SizeClass }
