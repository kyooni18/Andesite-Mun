{
  "name": "andesite-mun",
  "private": true,
  "version": "0.1.0",
  "description": "The M\u00fcn UI for Andesite: one codebase for the web app and the Tauri desktop app.",
  "type": "module",
  "mun": {
    "target": "web"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:types": "node scripts/gen-types.mjs",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "deploy": "node scripts/deploy.mjs",
    "link:mun": "node scripts/link-mun.mjs",
    "desktop:check": "node scripts/desktop-check.mjs",
    "desktop:dev": "tauri dev --no-watch",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@mun-ui/core": "0.2.0",
    "@mun-ui/ui": "0.2.0",
    "@mun-ui/web": "0.2.0",
    "dompurify": "3.4.18",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "marked": "18.2.1"
  },
  "devDependencies": {
    "@mun-ui/vite": "0.2.0",
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "26.1.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.1"
  }
}
